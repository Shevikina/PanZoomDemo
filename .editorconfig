root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
# Не строгая направляющая в редакторе: 100 символов, жёсткий предел остаётся 120.
ij_visual_guides = 100
# Позволяет отключить форматирование куска кода парой @formatter:off / @formatter:on.
ij_formatter_tags_enabled = true
ij_formatter_off_tag = @formatter:off
ij_formatter_on_tag = @formatter:on

[*.{kt,kts}]
# Соответствует kotlin.code.style=official из gradle.properties.
# Стиль ktlint_official навязывает собственные правила переносов, расходящиеся с кодом проекта.
ktlint_code_style = intellij_idea
max_line_length = 120
# Composable-функции по гайдлайнам Compose называются с большой буквы.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Пороги переноса как на прошлом проекте: у класса любой параметр уводит конструктор
# на отдельные строки, у функции - начиная со второго.
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 1
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = 2
# Тело в фигурных скобках не переписываем в expression body: на многострочном if/when читается хуже.
ktlint_standard_function-expression-body = disabled

# Настройки форматтера IDE: чтобы Reformat Code в студии делал то же, что ktlint,
# и файлы не дёргались туда-сюда между ними.
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_continuation_indent_size = 4
## Ручные переносы не схлопываются обратно при Reformat Code
ij_kotlin_keep_line_breaks = true
## Параметры объявления
ij_kotlin_method_parameters_wrap = on_every_item
ij_kotlin_method_parameters_new_line_after_left_paren = true
ij_kotlin_method_parameters_right_paren_on_new_line = true
ij_kotlin_continuation_indent_in_parameter_lists = false
## Аргументы вызова
ij_kotlin_call_parameters_wrap = on_every_item
ij_kotlin_call_parameters_new_line_after_left_paren = true
ij_kotlin_call_parameters_right_paren_on_new_line = true
ij_kotlin_continuation_indent_in_argument_lists = false
ij_kotlin_align_multiline_parameters_in_calls = false
## Запятая в конце списка: ktlint требует её и в объявлении, и в вызове
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
## Импорты: без звёздочек, java/javax/kotlin в конце
ij_kotlin_imports_layout = *,java.**,javax.**,kotlin.**,^
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647

[*.{xml,toml}]
indent_size = 4

[{*.yaml,*.yml}]
indent_size = 2
ij_yaml_keep_indents_on_empty_lines = unset
ij_yaml_keep_line_breaks = true
ij_yaml_spaces_within_brackets = false

# EditorConfig покрывает не все настройки XML.
# Стиль по умолчанию ставится в Editor > Code Style > XML > Set from... -> Android
[{**/res/**.xml,**/AndroidManifest.xml}]
ij_xml_continuation_indent_size = 4
ij_xml_keep_indents_on_empty_lines = unset
ij_xml_keep_line_breaks = false
ij_xml_keep_line_breaks_in_text = true
ij_xml_keep_blank_lines = 2
ij_xml_attribute_wrap = normal
ij_xml_text_wrap = normal
ij_xml_align_text = false
ij_xml_align_attributes = false
ij_xml_keep_whitespaces = false
ij_xml_space_around_equals_in_attribute = false
ij_xml_space_after_tag_name = false
ij_xml_space_inside_empty_tag = true
ij_xml_use_custom_settings = true

[*.md]
trim_trailing_whitespace = false
ij_markdown_wrap_text_if_long = false
ij_markdown_wrap_text_inside_blockquotes = false
ij_markdown_keep_line_breaks_inside_text_blocks = true
ij_markdown_format_tables = true
ij_markdown_max_lines_around_header = 1
ij_markdown_max_lines_around_block_elements = 1
ij_markdown_max_lines_between_paragraphs = 1
ij_markdown_min_lines_around_header = 1
ij_markdown_min_lines_around_block_elements = 1
ij_markdown_min_lines_between_paragraphs = 1
ij_markdown_force_one_space_between_words = true
ij_markdown_force_one_space_after_header_symbol = true
ij_markdown_force_one_space_after_list_bullet = true
ij_markdown_force_one_space_after_blockquote_symbol = true

[{*.bash,*.sh,*.zsh}]
indent_size = 2
tab_width = 2

[*.bat]
end_of_line = crlf

[*.properties]
ij_properties_keep_blank_lines = true
